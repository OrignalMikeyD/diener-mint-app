# Alchemy app URL for Polygon Amoy (create app at dashboard.alchemy.com, network: Polygon Amoy)
AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Private key of the STUNT WALLET ONLY. Never the wallet holding real funds.
PRIVATE_KEY=

# Constructor parameters for deployment
MINT_PRICE_POL=0.01
MAX_SUPPLY=5
BASE_URI=ipfs://your-contract-metadata-cid
ROYALTY_ARTIST_ADDRESS=
ROYALTY_BASIS_POINTS=500
